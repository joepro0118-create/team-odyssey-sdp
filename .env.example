# No credentials are required for the demo backend.
# Optional: set to browser for a per-tab preview or server for the local backend.
# Vercel defaults to browser; local development defaults to server.
NEXT_PUBLIC_DEMO_MODE=
# Optional account sign-in. Leave both blank to keep the login in setup mode.
# Use a public publishable key (or legacy anon key), never a secret/service-role key.
# Enable Google and configure redirects in Supabase; see docs/AUTH-SETUP.md.
# These settings do not connect marketplace listings to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
